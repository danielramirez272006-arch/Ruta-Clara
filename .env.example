# Configuración de Base de Datos MySQL (8.0.16 o superior)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ruta_clara
DB_USER=root
DB_PASSWORD=

# Configuración del Servidor Express
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configuración de Inteligencia Artificial — DeepSeek (recomendado / por defecto)
# Nunca exponga esta clave en el navegador ni la suba al repositorio.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alternativa opcional: Claude (Anthropic) si se llegara a usar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
